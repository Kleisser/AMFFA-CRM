APP_NAME="AMFFA CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amffa_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

# Puente GECROS (API de solo lectura hacia el SQL Server de producción).
# En Railway: GECROS_BRIDGE_URL es la URL HTTPS del Cloudflare Tunnel
# (ej. https://puente.tudominio.com) y GECROS_BRIDGE_KEY la API key compartida.
# IMPORTANTE: dejar vacías por defecto. Este archivo se copia a .env en
# Railway (start.sh) y valores no vacíos marcan el puente como "configurado".
GECROS_BRIDGE_URL=
GECROS_BRIDGE_KEY=

# Ventas reales (Google Sheets, cuenta de servicio de solo lectura).
# VENTAS_SPREADSHEETS: IDs de las planillas separados por coma
# (el ID va en la URL: docs.google.com/spreadsheets/d/<ID>/edit).
# VENTAS_SHEET_RANGE: pestaña y rango (ej. "Ventas!A1:Z200").
# GOOGLE_CREDENTIALS_PATH: archivo JSON de la cuenta de servicio (local);
# en Railway se pasa como GOOGLE_CREDENTIALS_BASE64 (start.sh lo materializa).
# IMPORTANTE: dejar vacías por defecto.
VENTAS_SPREADSHEETS=
VENTAS_SHEET_RANGE=Ventas!A1:Z200
GOOGLE_CREDENTIALS_PATH=
