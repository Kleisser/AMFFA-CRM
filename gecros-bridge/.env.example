# ============================================================
# Configuración del puente GECROS
# Copiar a .env y completar los valores reales.
# NUNCA commitear este archivo con credenciales reales.
# ============================================================

# Puerto local donde corre la API (cloudflared publica este puerto)
PORT=3000

# Credenciales de la BBDD GECROS (SOLO LECTURA)
# Crear en SQL Server un login dedicado con permisos únicamente de SELECT:
#   CREATE LOGIN crm_bridge WITH PASSWORD = '...';
#   CREATE USER crm_bridge FOR LOGIN crm_bridge;
#   GRANT SELECT ON dbo.benef TO crm_bridge;
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_DATABASE=GECROS
DB_USER=crm_bridge
DB_PASSWORD=cambiar_password
DB_ENCRYPT=true

# API key compartida: el CRM envía esta misma clave en el header X-API-Key
BRIDGE_API_KEY=cambiar_api_key_larga_y_aleatoria
